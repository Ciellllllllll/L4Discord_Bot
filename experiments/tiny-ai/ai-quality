#!/bin/sh
set -eu
base=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
umask 077
mkdir -p "$base/runs"
exec docker run --rm --network none --cpus 0.75 \
  --memory 512m --memory-swap 512m --pids-limit 128 \
  --read-only --tmpfs /tmp:size=32m --cap-drop ALL \
  --security-opt no-new-privileges \
  -v "$base/quality-data:/data:ro" -v "$base/runs:/runs" \
  --entrypoint python l4-tiny-ai:quality-v2 quality.py "$@"
