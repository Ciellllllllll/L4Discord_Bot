{
  "name": "l4discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node bot.ts",
    "bot": "node bot.ts",
    "dev": "cmd /c \"set BOT_PROFILE=debug&& tsx src/features/senryu/senryu.spec.ts && tsx watch src/index.ts\"",
    "dev:utf8": "cmd /c \"set BOT_PROFILE=debug&& chcp 65001>nul && tsx src/features/senryu/senryu.spec.ts && tsx watch src/index.ts\"",
    "migrate": "tsx src/scripts/migrateSqlite.ts up",
    "migrate:prod": "cmd /c \"set BOT_PROFILE=production&& tsx src/scripts/migrateSqlite.ts up\"",
    "migrate:debug": "cmd /c \"set BOT_PROFILE=debug&& tsx src/scripts/migrateSqlite.ts up\"",
    "migrate:down": "tsx src/scripts/migrateSqlite.ts down",
    "merge:vc-time": "tsx src/scripts/mergeVcTimeDbs.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "bottleneck": "^2.19.5",
    "cheerio": "^1.2.0",
    "discord.js": "^13.17.1",
    "dotenv": "^16.4.5",
    "kuromoji": "^0.1.2",
    "kysely": "^0.29.2",
    "pino": "^9.5.0",
    "semver": "^7.6.3",
    "tsx": "^4.19.2",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/semver": "^7.5.8",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.2"
  }
}
