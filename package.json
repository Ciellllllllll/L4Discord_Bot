{
  "name": "l4discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "bot": "npm run start",
    "dev": "cmd /c \"set BOT_PROFILE=debug&& node --env-file-if-exists=.env --import tsx src/features/senryu/senryu.spec.ts && node --env-file-if-exists=.env --import tsx --watch src/index.ts\"",
    "dev:utf8": "cmd /c \"set BOT_PROFILE=debug&& chcp 65001>nul && node --env-file-if-exists=.env --import tsx src/features/senryu/senryu.spec.ts && node --env-file-if-exists=.env --import tsx --watch src/index.ts\"",
    "migrate": "node --env-file-if-exists=.env --import tsx src/scripts/migrateSqlite.ts up",
    "migrate:prod": "cmd /c \"set BOT_PROFILE=production&& node --env-file-if-exists=.env --import tsx src/scripts/migrateSqlite.ts up\"",
    "migrate:debug": "cmd /c \"set BOT_PROFILE=debug&& node --env-file-if-exists=.env --import tsx src/scripts/migrateSqlite.ts up\"",
    "migrate:sqlite-to-postgres": "node --env-file-if-exists=.env --import tsx src/scripts/migrateSqliteToPostgres.ts",
    "verify:postgres-data": "node --env-file-if-exists=.env --import tsx src/scripts/verifyPostgresData.ts",
    "check:postgres-cutover": "node --env-file-if-exists=.env --import tsx src/scripts/checkPostgresCutoverReadiness.ts",
    "verify:openai-terra": "node --env-file-if-exists=.env --import tsx src/scripts/verifyOpenAiTerra.ts",
    "migrate:down": "node --env-file-if-exists=.env --import tsx src/scripts/migrateSqlite.ts down",
    "merge:vc-time": "tsx src/scripts/mergeVcTimeDbs.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-postgres-specs.mjs",
    "test:sqlite": "node --import tsx --test --test-concurrency=1 --test-timeout=120000 \"src/**/*.spec.ts\"",
    "test:postgres": "node scripts/run-postgres-specs.mjs"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "bottleneck": "^2.19.5",
    "cheerio": "^1.2.0",
    "discord.js": "^14.26.4",
    "kuromoji": "^0.1.2",
    "kysely": "^0.29.2",
    "pg": "^8.22.0",
    "pino": "^9.5.0",
    "semver": "^7.6.3",
    "tsx": "^4.19.2",
    "youtubei.js": "^17.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.20.0",
    "@types/semver": "^7.5.8",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.2"
  }
}
