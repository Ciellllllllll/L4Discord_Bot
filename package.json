{
  "name": "l4discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/scripts/migrateSqlite.ts up",
    "migrate:down": "tsx src/scripts/migrateSqlite.ts down",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "kysely": "^0.27.5",
    "pino": "^9.5.0",
    "semver": "^7.6.3",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.1",
    "@types/semver": "^7.5.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
