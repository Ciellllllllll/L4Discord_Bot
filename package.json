{
  "name": "l4discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "node --import dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js -f .pgmigraterc.cjs -m migrations up",
    "migrate:down": "node --import dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js -f .pgmigraterc.cjs -m migrations down",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "kysely": "^0.27.5",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "semver": "^7.6.3",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/semver": "^7.5.8",
    "node-pg-migrate": "^7.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
