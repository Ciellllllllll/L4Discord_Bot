# ============================================================
# L4Discord Bot 環境変数サンプル
# ============================================================
# 使い方:
# - 通常はこのファイルを参考に .env を作成します。
# - 空欄の項目は、必要な機能を使うときだけ設定してください。
# - BOT_PROFILE=production の場合は data/production/*、BOT_PROFILE=debug の場合は data/debug/* が既定の保存先です。
# - PRODUCTION_ または DEBUG_ 付きの値は、同名の共通設定より優先されます。


# ============================================================
# 1. 実行プロファイル
# ============================================================

# production は本番Bot・本番ギルド・data/production/* を使います。
# debug はデバッグBot・デバッグギルド・data/debug/* を使います。
BOT_PROFILE=production


# ============================================================
# 2. プロファイル別設定（production）
# ============================================================
# 本番用 Discord アプリや本番ギルドだけで使う値をここに設定します。

PRODUCTION_DISCORD_TOKEN=
PRODUCTION_DISCORD_CLIENT_ID=
PRODUCTION_GUILD_ID=
PRODUCTION_OWNER_ID=
PRODUCTION_ADMIN_ROLE_ID=

PRODUCTION_MOD_LOG_CHANNEL_ID=
PRODUCTION_LOGGER_CHANNEL_ID=
PRODUCTION_LOG_CHANNEL_ID=
PRODUCTION_MODMAIL_LOG_CHANNEL_ID=
PRODUCTION_APPEAL_REVIEW_CHANNEL_ID=
PRODUCTION_DETECTER_FALLBACK_CHANNEL_ID=
PRODUCTION_EXEC_CHANNEL_ID=
PRODUCTION_TIMEOUT_EXTEND_VOTE_CHANNEL_ID=
PRODUCTION_VC_CREATE_CATEGORY_ID=
PRODUCTION_REACTION_ROLE_UI_CHANNEL_ID=
PRODUCTION_REACTION_ROLE_OUTPUT_CHANNEL_ID=
# Steam/Epic無料ゲーム通知の本番投稿先。
PRODUCTION_GAME_DEAL_CHANNEL_ID=
PRODUCTION_GAME_DEAL_NOTIFY_ROLE_ID=
PRODUCTION_YOUTUBE_PREVIEW_ENABLED=
PRODUCTION_YOUTUBE_DATA_API_KEY=
PRODUCTION_YOUTUBE_REQUEST_TIMEOUT_MS=
# ADHD通知動画をVPSへ恒久保存するproduction専用設定。
PRODUCTION_ADHD_VIDEO_FILES_DIR=data/production/adhd-videos
PRODUCTION_ADHD_VIDEO_PUBLIC_BASE_URL=
PRODUCTION_ADHD_VIDEO_MIN_FREE_BYTES=1073741824
PRODUCTION_ADHD_VIDEO_CACHE_MAX_BYTES=21474836480
PRODUCTION_ADHD_VIDEO_RETENTION_DAYS=30
# YouTube の yt-dlp 利用設定。必要なときだけ本番値を分けてください。
PRODUCTION_YOUTUBE_YTDLP_ENABLED=
PRODUCTION_YOUTUBE_YTDLP_PATH=
PRODUCTION_YOUTUBE_YTDLP_TIMEOUT_MS=
PRODUCTION_GAME_DEAL_STEAM_NOW_INTERVAL_MS=
PRODUCTION_GAME_DEAL_EPIC_INTERVAL_MS=
PRODUCTION_GAME_DEAL_SUBSCRIPTION_INTERVAL_MS=

PRODUCTION_DEEPSEEK_API_KEY=
PRODUCTION_DEEPSEEK_API_BASE=
PRODUCTION_DEEPSEEK_MODEL=
PRODUCTION_DEEPSEEK_THINKING_ENABLED=
PRODUCTION_DEEPSEEK_THINKING_EFFORT=

# OpenAIを本番だけ別設定にする場合は、必要な行だけコメント解除してください。
# 空のプロファイル値も共通設定を上書きするため、未使用の行はコメントのままにします。
# PRODUCTION_OPENAI_API_KEY=
# PRODUCTION_OPENAI_ADMIN_KEY=
# PRODUCTION_OPENAI_PROJECT_ID=
# PRODUCTION_OPENAI_API_BASE=https://api.openai.com/v1
# PRODUCTION_OPENAI_MODEL_GPT56=gpt-5.6-terra
# PRODUCTION_OPENAI_MODEL_GPT54_MINI=gpt-5.4-mini-2026-03-17
# PRODUCTION_OPENAI_REASONING_EFFORT=high
# PRODUCTION_OPENAI_FALLBACK_THRESHOLD=2400000
# PRODUCTION_OPENAI_USAGE_CACHE_MS=30000
# PRODUCTION_OPENAI_MAX_COMPLETION_TOKENS=8192

PRODUCTION_JAPANESE_WORKER_ENABLED=
PRODUCTION_JAPANESE_WORKER_URL=
PRODUCTION_JAPANESE_WORKER_TIMEOUT_MS=
PRODUCTION_SENRYU_DETECTOR_MODE=
PRODUCTION_SENRYU_WORKER_FALLBACK_ENABLED=
PRODUCTION_SENRYU_WORKER_FALLBACK_ON_NO_MATCH=

PRODUCTION_PACCHI_LEARNING_ANALYZER=
PRODUCTION_PACCHI_PATTERN_LEARNING_ENABLED=
PRODUCTION_PACCHI_GENERATION_MODE=
PRODUCTION_PACCHI_AI_FINAL_CHECK_ENABLED=
PRODUCTION_PACCHI_WIKIPEDIA_API_BASE_URL=

PRODUCTION_DEEPLOL_WATCHER_ENABLED=
PRODUCTION_RIOT_API_KEY=
PRODUCTION_RIOT_PLATFORM_ID=
PRODUCTION_RIOT_REGIONAL_ROUTING=
PRODUCTION_DEEPLOL_BASE_URL=
PRODUCTION_DEEPLOL_MATCH_URL_TEMPLATE=

# プロファイル別のデータ保存先を明示したい場合だけ使います。
# PRODUCTION_DATABASE_PATH=data/production/l4discord.sqlite

# 事前に `BOT_PROFILE=production npm run check:postgres-cutover`、
# `BOT_PROFILE=production npm run migrate:sqlite-to-postgres`、
# `BOT_PROFILE=production npm run verify:postgres-data` を実行し、全件保持を確認してください。
# PRODUCTION_DATABASE_URL=postgres://l4bot:password@127.0.0.1:5432/l4discord
# PRODUCTION_POSTGRES_MAIN_SCHEMA=main
# PRODUCTION_POSTGRES_TICKET_SCHEMA=ticket
# PRODUCTION_POSTGRES_MESSAGE_LOG_SCHEMA=message_log
# PRODUCTION_POSTGRES_MESSAGE_ATTACHMENT_SCHEMA=message_attachment
# PRODUCTION_POSTGRES_VC_TIME_SCHEMA=vc_time
# PRODUCTION_POSTGRES_AI_HISTORY_SCHEMA=ai_history
# PRODUCTION_POSTGRES_AUTOMOD_SCHEMA=automod
# PRODUCTION_POSTGRES_REMINDER_SCHEMA=reminder


# ============================================================
# 3. プロファイル別設定（debug）
# ============================================================
# デバッグ用 Discord アプリやデバッグギルドだけで使う値をここに設定します。

DEBUG_DISCORD_TOKEN=
DEBUG_DISCORD_CLIENT_ID=
DEBUG_GUILD_ID=
DEBUG_OWNER_ID=
DEBUG_ADMIN_ROLE_ID=

DEBUG_MOD_LOG_CHANNEL_ID=
DEBUG_LOGGER_CHANNEL_ID=
DEBUG_LOG_CHANNEL_ID=
DEBUG_MODMAIL_LOG_CHANNEL_ID=
DEBUG_APPEAL_REVIEW_CHANNEL_ID=
DEBUG_DETECTER_FALLBACK_CHANNEL_ID=
DEBUG_EXEC_CHANNEL_ID=
DEBUG_TIMEOUT_EXTEND_VOTE_CHANNEL_ID=
DEBUG_VC_CREATE_CATEGORY_ID=
DEBUG_REACTION_ROLE_UI_CHANNEL_ID=
DEBUG_REACTION_ROLE_OUTPUT_CHANNEL_ID=
# Steam/Epic無料ゲーム通知のデバッグ投稿先。
DEBUG_GAME_DEAL_CHANNEL_ID=
DEBUG_GAME_DEAL_NOTIFY_ROLE_ID=
DEBUG_YOUTUBE_PREVIEW_ENABLED=
DEBUG_YOUTUBE_DATA_API_KEY=
DEBUG_YOUTUBE_REQUEST_TIMEOUT_MS=
# YouTube の yt-dlp 利用設定。必要なときだけデバッグ値を分けてください。
DEBUG_YOUTUBE_YTDLP_ENABLED=
DEBUG_YOUTUBE_YTDLP_PATH=
DEBUG_YOUTUBE_YTDLP_TIMEOUT_MS=
DEBUG_GAME_DEAL_STEAM_NOW_INTERVAL_MS=
DEBUG_GAME_DEAL_EPIC_INTERVAL_MS=
DEBUG_GAME_DEAL_SUBSCRIPTION_INTERVAL_MS=

DEBUG_DEEPSEEK_API_KEY=
DEBUG_DEEPSEEK_API_BASE=
DEBUG_DEEPSEEK_MODEL=
DEBUG_DEEPSEEK_THINKING_ENABLED=
DEBUG_DEEPSEEK_THINKING_EFFORT=

# OpenAIをデバッグ環境だけ別設定にする場合は、必要な行だけコメント解除してください。
# 空のプロファイル値も共通設定を上書きするため、未使用の行はコメントのままにします。
# DEBUG_OPENAI_API_KEY=
# DEBUG_OPENAI_ADMIN_KEY=
# DEBUG_OPENAI_PROJECT_ID=
# DEBUG_OPENAI_API_BASE=https://api.openai.com/v1
# DEBUG_OPENAI_MODEL_GPT56=gpt-5.6-terra
# DEBUG_OPENAI_MODEL_GPT54_MINI=gpt-5.4-mini-2026-03-17
# DEBUG_OPENAI_REASONING_EFFORT=high
# DEBUG_OPENAI_FALLBACK_THRESHOLD=2400000
# DEBUG_OPENAI_USAGE_CACHE_MS=30000
# DEBUG_OPENAI_MAX_COMPLETION_TOKENS=8192

DEBUG_JAPANESE_WORKER_ENABLED=
DEBUG_JAPANESE_WORKER_URL=
DEBUG_JAPANESE_WORKER_TIMEOUT_MS=
DEBUG_SENRYU_DETECTOR_MODE=
DEBUG_SENRYU_WORKER_FALLBACK_ENABLED=
DEBUG_SENRYU_WORKER_FALLBACK_ON_NO_MATCH=

DEBUG_PACCHI_LEARNING_ANALYZER=
DEBUG_PACCHI_PATTERN_LEARNING_ENABLED=
DEBUG_PACCHI_GENERATION_MODE=
DEBUG_PACCHI_AI_FINAL_CHECK_ENABLED=
DEBUG_PACCHI_WIKIPEDIA_API_BASE_URL=

DEBUG_DEEPLOL_WATCHER_ENABLED=
DEBUG_RIOT_API_KEY=
DEBUG_RIOT_PLATFORM_ID=
DEBUG_RIOT_REGIONAL_ROUTING=
DEBUG_DEEPLOL_BASE_URL=
DEBUG_DEEPLOL_MATCH_URL_TEMPLATE=

# プロファイル別のデータ保存先を明示したい場合だけ使います。
# DEBUG_DATABASE_PATH=data/debug/l4discord.sqlite

# デバッグ環境のPostgreSQL接続先です。
# DEBUG_DATABASE_URL=postgres://l4bot:password@127.0.0.1:5432/l4discord_debug
# DEBUG_POSTGRES_MAIN_SCHEMA=main_debug
# DEBUG_POSTGRES_TICKET_SCHEMA=ticket_debug
# DEBUG_POSTGRES_MESSAGE_LOG_SCHEMA=message_log_debug
# DEBUG_POSTGRES_MESSAGE_ATTACHMENT_SCHEMA=message_attachment_debug
# DEBUG_POSTGRES_VC_TIME_SCHEMA=vc_time_debug
# DEBUG_POSTGRES_AI_HISTORY_SCHEMA=ai_history_debug
# DEBUG_POSTGRES_AUTOMOD_SCHEMA=automod_debug
# DEBUG_POSTGRES_REMINDER_SCHEMA=reminder_debug


# ============================================================
# 4. 共通の必須設定
# ============================================================
# プロファイル別設定が空の場合に使われる共通値です。

# Discord Bot Token。`Bot ` や `Bearer ` を付けず、生のトークンだけを設定します。
DISCORD_TOKEN=

# Discord Developer Portal のアプリケーションID。
DISCORD_CLIENT_ID=

# 対象サーバーID。
GUILD_ID=

# Bot所有者のユーザーID。
OWNER_ID=

# 管理者ロールID。
ADMIN_ROLE_ID=


# ============================================================
# 5. ログ・起動補助
# ============================================================

# ターミナルへ DEBUG レベルのログを出すか。
# 未設定時は NODE_ENV に従い、production 以外では DEBUG 相当になります。
# LOG_DEBUG=0
# LOG_DEBUG=1


# ============================================================
# 6. OpenAI / DeepSeek / AI 機能
# ============================================================
# 起動だけなら未設定でも構いません。AI コマンドや AI レビューを使う場合に必要です。

# OpenAI Responses API用のProject APIキー。未設定時はOpenAIを利用しません。
OPENAI_API_KEY=

# 組織Usage API用のAdmin Key。日次トークン使用量の取得に使います。
OPENAI_ADMIN_KEY=

# Botが利用するOpenAI Project ID。組織全体の利用量からBot分を識別するために使います。
OPENAI_PROJECT_ID=

# OpenAI APIのベースURLと、/switch で選択する利用モデル。
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL_GPT56=gpt-5.6-terra
OPENAI_MODEL_GPT54_MINI=gpt-5.4-mini-2026-03-17

# reasoning effort。none / low / medium / high / xhigh のいずれかです。
OPENAI_REASONING_EFFORT=high

# 安全フォールバックしきい値、Usage APIキャッシュ時間、最大出力トークン数。
OPENAI_FALLBACK_THRESHOLD=2400000
OPENAI_USAGE_CACHE_MS=30000
OPENAI_MAX_COMPLETION_TOKENS=8192

DEEPSEEK_API_KEY=

# 任意。未設定時は既定の DeepSeek API エンドポイントを使います。
DEEPSEEK_API_BASE=

# 未設定時はコード側の既定モデルを使います。
# DEEPSEEK_MODEL=deepseek-v4-flash

# 既定ON。ユーザー単位の /thinking 設定でも切り替えられます。
# DEEPSEEK_THINKING_ENABLED=1
# DEEPSEEK_THINKING_EFFORT=high


# ============================================================
# 7. 処刑・タイムアウト延長フロー
# ============================================================

# /処刑 の投票秒数。既定は 20 秒です。
# EXEC_VOTE_SECONDS=20

# /処刑 の管理者承認待ち秒数。既定は 600 秒です。
# EXEC_ADMIN_WAIT_SECONDS=600

# 空なら全チャンネルで実行可能。指定時はそのチャンネルだけで /処刑 と /タイムアウト延長 を起動できます。
# EXEC_CHANNEL_ID=

# /タイムアウト延長 の投票・承認メッセージ投稿先。未設定時はコマンド実行チャンネルを使います。
# TIMEOUT_EXTEND_VOTE_CHANNEL_ID=

# /タイムアウト延長 の管理者承認待ち秒数。既定は 120 秒です。
# TIMEOUT_EXTEND_ADMIN_WAIT_SECONDS=120

# 空なら事前チェックなし。指定時、対象がこのロールを持たない場合は管理者の事前承認が必要です。
# EXECUTOR_ROLE_ID=


# ============================================================
# 8. データベース・保存先
# ============================================================
# 未設定時は BOT_PROFILE に応じて data/production/* または data/debug/* を使います。
# Docker 等では data ディレクトリをボリュームにマウントしないと、コンテナ再作成でDBが消えます。

# メインDB。
# DATABASE_PATH=data/l4discord.sqlite

# メッセージログ専用DB。LOG_DB_PATH でも上書きできます。
# MESSAGE_LOG_DB_PATH=data/message.db

# 添付ファイル保存メタDBと実体ファイル保存先。
# MESSAGE_ATTACHMENT_STORE_DB_PATH=data/message_attachment_store.db
# MESSAGE_ATTACHMENT_FILES_DIR=data/message_log_attachments
# MESSAGE_ATTACHMENT_ARCHIVE_ENABLED=1

# 各機能の専用DB。
# TICKET_DATABASE_PATH=data/ticket.db
# AI_HISTORY_DATABASE_PATH=data/AI_History.db
# AUTOMODERATION_DATABASE_PATH=data/Automoderation.db
# REMINDER_DATABASE_PATH=data/reminder.db

# VC滞在セッション専用DBとランキング集計タイムゾーン。
# VC_TIME_DATABASE_PATH=data/vc_time.db
# VC_TIME_RANKING_TIMEZONE=Asia/Tokyo

# PostgreSQL接続URL。Bot起動時に必須です。
# 本番では上のPRODUCTION_*を使い、共通値へ秘密情報を直書きしないでください。
# DATABASE_URL=postgres://l4bot:password@127.0.0.1:5432/l4discord

# PostgreSQL schema名。通常は既定値のままで構いません。
# 同じDATABASE_URLに複数環境を同居させる場合は、各schema名を重複させないでください。
# POSTGRES_MAIN_SCHEMA=main
# POSTGRES_TICKET_SCHEMA=ticket
# POSTGRES_MESSAGE_LOG_SCHEMA=message_log
# POSTGRES_MESSAGE_ATTACHMENT_SCHEMA=message_attachment
# POSTGRES_VC_TIME_SCHEMA=vc_time
# POSTGRES_AI_HISTORY_SCHEMA=ai_history
# POSTGRES_AUTOMOD_SCHEMA=automod
# POSTGRES_REMINDER_SCHEMA=reminder


# ============================================================
# 9. チャンネルID
# ============================================================
# 任意項目は空欄のままで構いません。

# Detecter理由入力、Modmailスタッフスレッドの親、退出通知などの既定先。
MOD_LOG_CHANNEL_ID=

# DiscordBOTv2 互換のログチャンネル候補。
LOGGER_CHANNEL_ID=
LOG_CHANNEL_ID=

# Modmail 専用の親チャンネル上書き。
MODMAIL_LOG_CHANNEL_ID=

# 異議申し立ての審査チャンネル。
APPEAL_REVIEW_CHANNEL_ID=

# Detecter の最終フォールバック投稿先。
DETECTER_FALLBACK_CHANNEL_ID=

# 一時VCを作成するカテゴリID。未設定時は既存VCから推定します。
# VC_CREATE_CATEGORY_ID=

# リアクションロール管理画面と出力先。
# REACTION_ROLE_UI_CHANNEL_ID=
# REACTION_ROLE_OUTPUT_CHANNEL_ID=

# Steam/Epic無料ゲーム通知の投稿先。無料ゲーム通知を使う場合は設定してください。
# profile別に分ける場合は上の PRODUCTION_GAME_DEAL_CHANNEL_ID / DEBUG_GAME_DEAL_CHANNEL_ID を使います。
# GAME_DEAL_CHANNEL_ID=

# 通知時にメンションするロール。未設定ならロールメンションなしで通知します。
# GAME_DEAL_NOTIFY_ROLE_ID=

# YouTubeリンクのプレビュー投稿。未設定・空は有効、0/false/off/no で無効です。
# PROFILE別に分ける場合は PRODUCTION_YOUTUBE_PREVIEW_ENABLED / DEBUG_YOUTUBE_PREVIEW_ENABLED を使います。
# YOUTUBE_PREVIEW_ENABLED=true

# YouTube Data APIキー。未設定でもURLプレビューは動きますが、動画メタデータ取得には設定してください。
# PROFILE別に分ける場合は PRODUCTION_YOUTUBE_DATA_API_KEY / DEBUG_YOUTUBE_DATA_API_KEY を使います。
# YOUTUBE_DATA_API_KEY=

# YouTube Data APIリクエストのタイムアウト。既定 10000ms、範囲 1000-30000ms。
# PROFILE別に分ける場合は PRODUCTION_YOUTUBE_REQUEST_TIMEOUT_MS / DEBUG_YOUTUBE_REQUEST_TIMEOUT_MS を使います。
# YOUTUBE_REQUEST_TIMEOUT_MS=10000

# YouTube の yt-dlp 利用設定。未設定・空は有効 / yt-dlp / 15000ms を使います。
# PROFILE別に分ける場合は PRODUCTION_YOUTUBE_YTDLP_ENABLED / DEBUG_YOUTUBE_YTDLP_ENABLED を使います。
# YOUTUBE_YTDLP_ENABLED=1
# YOUTUBE_YTDLP_PATH=yt-dlp
# YOUTUBE_YTDLP_TIMEOUT_MS=15000
ADHD_WATCHER_ENABLED=true
ADHD_POLL_INTERVAL_MS=60000
ADHD_RSS_REQUEST_TIMEOUT_MS=10000

# Steamストア検索から現在100%OFFの有料ゲームを直接探す間隔。既定 1800000ms、最小 60000ms。
# GAME_DEAL_STEAM_NOW_INTERVAL_MS=1800000

# Epic無料ゲーム取得間隔。既定 3600000ms、最小 60000ms。
# GAME_DEAL_EPIC_INTERVAL_MS=3600000

# 購読ゲームの価格チェック間隔。既定 3600000ms、最小 60000ms。
# GAME_DEAL_SUBSCRIPTION_INTERVAL_MS=3600000


# ============================================================
# 10. 川柳検出
# ============================================================
# 既定では無効です。Go worker を使わない場合は既存 kuromoji 検出を使います。

# 川柳検出を有効化します。
# SENRYU_ENABLED=1

# 検出時に返信します。
# SENRYU_REPLY_ENABLED=1

# 検出結果をDBへ保存します。
# SENRYU_SAVE_ENABLED=1

# kuromoji 辞書ディレクトリを明示したい場合だけ設定します。
# SENRYU_KUROMOJI_DICT_PATH=

# 各句のモーラ数を ±1 まで許容します。取りこぼしは減りますが、誤検知は増えます。
# SENRYU_MORA_TOLERANCE=1

# 複数候補がある場合、5-7-5 に最も近い候補を選びます。
# SENRYU_BEST_CANDIDATE=1

# js-haiku の 5-7-5 検証と一致した候補だけ採用します。
# SENRYU_JS_HAIKU_VERIFY_ENABLED=1

# 選択中のAI providerで候補だけを最終審査します。API失敗時は検出結果をそのまま採用します。
# SENRYU_AI_REVIEW_ENABLED=1
# SENRYU_AI_REVIEW_TIMEOUT_MS=20000
# SENRYU_AI_REVIEW_MODEL=


# ============================================================
# 11. 日本語解析 Go worker
# ============================================================
# 既定OFFです。有効化すると Bot 起動時に worker も自動起動し、Bot 終了時に停止します。
# 既に /health が成功する worker が外部起動済みの場合、Bot は二重起動せず、その外部プロセスは停止しません。
# worker は外部公開せず、127.0.0.1 のみで待ち受ける想定です。

# Go worker を使う機能全体の有効化。
# JAPANESE_WORKER_ENABLED=0

# 短い別名です。JAPANESE_WORKER_ENABLED が未設定の場合だけ使われます。
# WORKER_ENABLED=0

# Bot から接続する worker URL。
# JAPANESE_WORKER_URL=http://127.0.0.1:8787

# worker への1リクエストのタイムアウト。
# JAPANESE_WORKER_TIMEOUT_MS=1500

# 川柳検出器の切り替え。kuromoji は既存方式、go-worker は Kagome/UniDic worker 方式です。
# SENRYU_DETECTOR_MODE=kuromoji

# worker 失敗時に kuromoji へフォールバックします。
# SENRYU_WORKER_FALLBACK_ENABLED=1

# worker が matched:false を返した場合にも kuromoji を試します。既定OFFです。
# SENRYU_WORKER_FALLBACK_ON_NO_MATCH=0


# ============================================================
# 12. ぱっちぃ
# ============================================================
# 既定では既存テンプレート生成と既存学習を維持します。

# 用語説明で使う日本語版 Wikipedia REST API の summary エンドポイント。
# PACCHI_WIKIPEDIA_API_BASE_URL=https://ja.wikipedia.org/api/rest_v1/page/summary

# 学習用の日本語解析方式。go-worker は JAPANESE_WORKER_ENABLED=1 のときだけ使います。
# PACCHI_LEARNING_ANALYZER=kuromoji

# 文型学習を有効化します。既定OFFです。
# PACCHI_PATTERN_LEARNING_ENABLED=0

# 返信生成方式。
# template: 既存の手書きテンプレート
# slot-template: 品詞スロットテンプレート
# learned-pattern: 学習文型
# mixed: 手書き・スロット・学習文型を混合
# PACCHI_GENERATION_MODE=template

# 生成後の安全チェックだけにAIを使います。通常文の生成にはAIを使いません。
# PACCHI_AI_FINAL_CHECK_ENABLED=0

# ============================================================
# 13. Bokete API
# ============================================================
# Bokete API Worker のベースURL。PRODUCTION_BOKETE_API_BASE_URL / DEBUG_BOKETE_API_BASE_URL でも上書きできます。
BOKETE_API_BASE_URL=https://bokete-api-worker.cielgameee.workers.dev
BOKETE_REQUEST_TIMEOUT_MS=10000


# ============================================================
# 14. LoL試合監視
# ============================================================
# Riot APIで試合の開始・終了・KDA・勝敗・KPなどを取得します。
# DeepLOL は試合終了後の詳細URL補完とAIスコア取得に使います。

DEEPLOL_WATCHER_ENABLED=false
RIOT_API_KEY=
RIOT_PLATFORM_ID=jp1
RIOT_REGIONAL_ROUTING=asia
RIOT_REQUEST_TIMEOUT_MS=12000

DEEPLOL_BASE_URL=

# 空欄なら https://www.deeplol.gg/summoner/jp/{accountKey} を使います。
# 使用可能なプレースホルダ: {gameId}, {accountKey}, {gameName}, {tagLine}, {puuid}
DEEPLOL_MATCH_URL_TEMPLATE=

DEEPLOL_POLL_INTERVAL_MS=120000
DEEPLOL_ACTIVE_STALE_MS=3600000
DEEPLOL_SCRAPE_DELAY_MIN_MS=60000
DEEPLOL_SCRAPE_DELAY_MAX_MS=180000
