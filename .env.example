# Discord — Developer Portal で発行した Bot トークン
DISCORD_TOKEN=

# Discord — アプリケーション ID（Snowflake）
DISCORD_CLIENT_ID=

# 対象ギルド ID（単一サーバー専用 Bot）
GUILD_ID=

# SQLite データベースファイル（相対パスはプロジェクトルート基準）
DATABASE_PATH=data/l4discord.sqlite

# Modmail / 異議申し立て / 汎用 tickets 専用 DB（未設定時は data/ticket.db）
# TICKET_DATABASE_PATH=data/ticket.db

# Bot オーナーのユーザー ID（Snowflake）— OWNER 専用コマンド用
OWNER_ID=

# 管理者ロール ID — このロールを持つメンバーを管理者として扱う
ADMIN_ROLE_ID=

# 機能ゲート用のセマンティックバージョン（例: 2.0.0）
BOT_VERSION=0.1.0

# DeepSeek — API キーとベース URL（ベース配下に OpenAI 互換の chat completions パス）
DEEPSEEK_API_KEY=
# 任意。未設定時はコード側の既定（プロバイダのルート）を使用
DEEPSEEK_API_BASE=
# 任意 — /q 周り（DiscordBOTv2 AI_Query.js 相当）
# DEEPSEEK_MODEL=deepseek-chat
# AI_REQUEST_TIMEOUT_MS=45000
# AI_MAX_RETRIES=2
# AI_TEMPERATURE=0.7
# AI_JUDGE_ENABLED=1
# AI_JUDGE_TEMPERATURE=0.15
# AI_COMMAND_EXECUTION_ENABLED=1
# AI_ACTION_RATE_LIMIT=5
# AI_LOG_COMMANDS_TO_HISTORY=0
# AI_HISTORY_MAX_MESSAGES=24
# PROMPT_FILE_PATH=prompt.txt
# USER_PROMPT_DIR=data/AI/prompt/user
# CHAT_MONITOR_ENABLED=0
# AI_MAX_RESPONSE_BYTES=2000000
# PROMPT_OPTIMIZER_ENABLED=1
# PROMPT_OPTIMIZER_MAX_HISTORY=24
# PROMPT_OPTIMIZER_MIN_MESSAGES=6
# PROMPT_OPTIMIZER_INTERVAL_MESSAGES=4
# PROMPT_OPTIMIZER_TEMPERATURE=0.2
# 任意 — /q 履歴管理パネル専用チャンネル（未設定時は LOG_CHANNEL_ID → LOGGER_CHANNEL_ID → DETECTER_FALLBACK_CHANNEL_ID）
# AI_QUERY_HISTORY_UI_CHANNEL_ID=

# 任意 — Detecter「理由入力」プロンプトの投稿先（最優先。チャンネル末尾に新規投稿）
MOD_LOG_CHANNEL_ID=
# 任意 — 上記未設定時のフォールバック（DiscordBOTv2 の LOGGER_CHANNEL_ID / LOG_CHANNEL_ID と同等）
LOGGER_CHANNEL_ID=
LOG_CHANNEL_ID=
# 任意 — 上記が未設定のときのフォールバック（Snowflake）
DETECTER_FALLBACK_CHANNEL_ID=
# 任意 — Detecter タイムアウト（秒）
# DETECTER_PROMPT_TIMEOUT_SEC=1800
# DETECTER_AUDIT_WINDOW_SEC=45
# DETECTER_DEFAULT_APPEAL_WINDOW_SEC=2592000
# DETECTER_DEFAULT_REASON_TEXT=モデレーターによる理由は未入力です。

# 任意 — Detecter 経由の異議申し立てを審査するテキストチャンネル（未設定時は LOG_CHANNEL_ID → LOGGER_CHANNEL_ID → MODMAIL_LOG_CHANNEL_ID）
APPEAL_REVIEW_CHANNEL_ID=

# 任意 — true ならギルドへのスラッシュコマンド登録をスキップ（CI や二重起動時など）
SKIP_COMMAND_SYNC=false

# 任意 — REST でコマンド同期するまでのデバウンス（ミリ秒、既定 0）
COMMAND_SYNC_DEBOUNCE_MS=0

# 任意 — warn のときだけギルド不一致時にログのみ（既定はプロセス終了）
GUILD_MISMATCH_POLICY=

# 任意 — false / 0 でターミナルでも JSON 一行（既定は開発時は整形表示）。NODE_ENV=production では常に JSON
LOG_PRETTY=
