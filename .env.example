# --- Runtime profile ---
# production: production bot, guild, channels, and data/production/*
# debug: debug bot, guild, channels, and data/debug/*
# Start the bot the usual way: node bot.ts
# Change PROFILE here to switch the bot, guild, channels, and data directory.
PROFILE=production
# BOT_PROFILE=production is also supported for compatibility.

# Profile-specific values override the common values below.
# Use these when running separate production/debug Discord applications.
PRODUCTION_DISCORD_TOKEN=
PRODUCTION_DISCORD_CLIENT_ID=
PRODUCTION_GUILD_ID=
PRODUCTION_OWNER_ID=
PRODUCTION_ADMIN_ROLE_ID=
PRODUCTION_MOD_LOG_CHANNEL_ID=
PRODUCTION_LOGGER_CHANNEL_ID=
PRODUCTION_LOG_CHANNEL_ID=
PRODUCTION_MODMAIL_LOG_CHANNEL_ID=
PRODUCTION_APPEAL_REVIEW_CHANNEL_ID=
PRODUCTION_DETECTER_FALLBACK_CHANNEL_ID=
PRODUCTION_EXEC_CHANNEL_ID=
PRODUCTION_TIMEOUT_EXTEND_VOTE_CHANNEL_ID=
PRODUCTION_VC_CREATE_CATEGORY_ID=
PRODUCTION_REACTION_ROLE_UI_CHANNEL_ID=
PRODUCTION_REACTION_ROLE_OUTPUT_CHANNEL_ID=
PRODUCTION_DEEPSEEK_API_KEY=
PRODUCTION_DEEPSEEK_API_BASE=
PRODUCTION_DEEPSEEK_MODEL=
PRODUCTION_DEEPSEEK_THINKING_ENABLED=
PRODUCTION_DEEPSEEK_THINKING_EFFORT=

DEBUG_DISCORD_TOKEN=
DEBUG_DISCORD_CLIENT_ID=
DEBUG_GUILD_ID=
DEBUG_OWNER_ID=
DEBUG_ADMIN_ROLE_ID=
DEBUG_MOD_LOG_CHANNEL_ID=
DEBUG_LOGGER_CHANNEL_ID=
DEBUG_LOG_CHANNEL_ID=
DEBUG_MODMAIL_LOG_CHANNEL_ID=
DEBUG_APPEAL_REVIEW_CHANNEL_ID=
DEBUG_DETECTER_FALLBACK_CHANNEL_ID=
DEBUG_EXEC_CHANNEL_ID=
DEBUG_TIMEOUT_EXTEND_VOTE_CHANNEL_ID=
DEBUG_VC_CREATE_CATEGORY_ID=
DEBUG_REACTION_ROLE_UI_CHANNEL_ID=
DEBUG_REACTION_ROLE_OUTPUT_CHANNEL_ID=
DEBUG_DEEPSEEK_API_KEY=
DEBUG_DEEPSEEK_API_BASE=
DEBUG_DEEPSEEK_MODEL=
DEBUG_DEEPSEEK_THINKING_ENABLED=
DEBUG_DEEPSEEK_THINKING_EFFORT=

# Optional profile-specific data paths. If omitted:
# production uses data/production/*
# debug uses data/debug/*
# PRODUCTION_DATABASE_PATH=data/production/l4discord.sqlite
# DEBUG_DATABASE_PATH=data/debug/l4discord.sqlite

# --- TOKEN ---
DISCORD_TOKEN=

# --- Discord API（アプリケーション ID）---
DISCORD_CLIENT_ID=
GUILD_ID=
OWNER_ID=

# ターミナルに DEBUG レベルのログを出す（1=ON / 0=OFF）。未設定時は NODE_ENV に従う（production 以外は ON）
# LOG_DEBUG=0
# LOG_DEBUG=1

# --- DeepSeek API ---
# Optional at startup. Required only when using AI commands/features.
DEEPSEEK_API_KEY=
# 任意（未設定時はプロバイダ既定）
DEEPSEEK_API_BASE=
# 未設定時は deepseek-v4-flash。旧 deepseek-reasoner は使わず、Thinking は下記で切り替えます。
# DEEPSEEK_MODEL=deepseek-v4-flash
# 既定ON。/thinking enabled:true/false でユーザー単位の上書きができます。
# DEEPSEEK_THINKING_ENABLED=1
# DEEPSEEK_THINKING_EFFORT=high

# --- ROLE_ID ---
ADMIN_ROLE_ID=
# /処刑 フロー（DiscordBOTv2 PublicExecution 相当）
# EXEC_VOTE_SECONDS=20
# EXEC_ADMIN_WAIT_SECONDS=600
# 空なら全チャンネル可。指定時はそのテキストチャンネルのみ（/タイムアウト延長 の起動も同じ）
# EXEC_CHANNEL_ID=
# /タイムアウト延長: 投票・承認メッセージの投稿先（未設定時はコマンド実行チャンネル）
# TIMEOUT_EXTEND_VOTE_CHANNEL_ID=
# 管理者承認の待ち秒数（既定 120）
# TIMEOUT_EXTEND_ADMIN_WAIT_SECONDS=120
# 空ならスキップ。指定時、対象がこのロールを持たないと管理者の事前承認が必要
# EXECUTOR_ROLE_ID=

# --- DB パス（任意。未設定時は既定ファイル）---
# メッセージログは MESSAGE_LOG_DB_PATH / LOG_DB_PATH（既定 data/message.db）
# 添付ローカル複製のメタは MESSAGE_ATTACHMENT_STORE_DB_PATH（既定 data/message_attachment_store.db）
# MESSAGE_ATTACHMENT_FILES_DIR=data/message_log_attachments
# MESSAGE_ATTACHMENT_ARCHIVE_ENABLED=1
# AI_HISTORY_DATABASE_PATH=data/AI_History.db
# AUTOMODERATION_DATABASE_PATH=data/Automoderation.db
# リマインダーハブ専用（REMINDER_DB_PATH でも可）
# REMINDER_DATABASE_PATH=data/reminder.db
#
# VC 滞在セッションはメインDBではなく専用ファイルに保存されます（マイグレーション005以降）。
# VC_TIME_DATABASE_PATH=data/vc_time.db
# 「今日／週／月」のランキング境界に使う IANA タイムゾーン（既定: Asia/Tokyo）
# VC_TIME_RANKING_TIMEZONE=Asia/Tokyo
#
# Docker 等では data ディレクトリをボリュームにマウントしないと、コンテナ再作成で DB が空に戻ることがあります。

# --- CHANNEL_ID（任意のものは空で可）---
# Detecter 理由入力・Modmail スタッフスレッドの親・退出通知の既定先（最優先）
MOD_LOG_CHANNEL_ID=
LOGGER_CHANNEL_ID=
LOG_CHANNEL_ID=
MODMAIL_LOG_CHANNEL_ID=
APPEAL_REVIEW_CHANNEL_ID=
DETECTER_FALLBACK_CHANNEL_ID=

# --- 川柳（kuromoji・任意）---
# SENRYU_ENABLED=1
# SENRYU_REPLY_ENABLED=1
# SENRYU_SAVE_ENABLED=1
# 雑談で取りこぼしを減らす例: 各句モーラを ±1 許容し、複数候補から 5/7/5 に最も近いものを選ぶ（誤検知も増えうる）
# SENRYU_MORA_TOLERANCE=1
# SENRYU_BEST_CANDIDATE=1
# go-haiku 相当の 5-7-5 列挙と候補が一致する場合のみ採用（偽陽性低減。未設定はオフ）
# SENRYU_JS_HAIKU_VERIFY_ENABLED=1
# 検出後に DeepSeek で候補のみ再審査（API 失敗・JSON 不正時は検出結果をそのまま採用）
# SENRYU_AI_REVIEW_ENABLED=1
# SENRYU_AI_REVIEW_TIMEOUT_MS=20000
# SENRYU_AI_REVIEW_MODEL=（未設定で DEEPSEEK_MODEL）

# --- ぱっちぃ（任意）---
# 用語説明で使う Wikipedia REST API の summary endpoint。
# 未設定時は日本語版 Wikipedia を使います。
# PACCHI_WIKIPEDIA_API_BASE_URL=https://ja.wikipedia.org/api/rest_v1/page/summary
# PRODUCTION_PACCHI_WIKIPEDIA_API_BASE_URL=
# DEBUG_PACCHI_WIKIPEDIA_API_BASE_URL=
