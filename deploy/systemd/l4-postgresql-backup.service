[Unit]
Description=L4 PostgreSQL logical backup
After=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
UMask=0077
EnvironmentFile=-/etc/l4discord/postgresql-backup.env
ExecStart=/usr/local/sbin/l4-postgresql-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/postgresql/l4
